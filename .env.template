# Azure AI Foundry project endpoint (NOT connection string)
# Format: https://<AIFoundryResourceName>.services.ai.azure.com/api/projects/<ProjectName>
# Find this: Foundry portal → your project → Overview → "Project endpoint" under Libraries
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project

# Deployed model name (must match what's deployed in your Foundry project)
MODEL_DEPLOYMENT_NAME=gpt-4o

# Azure AI Content Safety endpoint
# Find this: Azure portal → your Content Safety resource → Keys and Endpoint
CONTENT_SAFETY_ENDPOINT=https://your-contentsafety.cognitiveservices.azure.com/
